# ============================================================
# GLOBAL CONFIGURATION — copy this file to .env and fill in
# All deploy scripts source this file automatically
#
# HOW TO USE:
#   cp .env.example .env
#   then open .env and fill in any values marked with TODO
# ============================================================

# ── Project ──────────────────────────────────────────────────

# Your Google Cloud project ID (find it in GCP Console → Project selector)
PROJECT_ID=secure-devops-setup

# ── Location ─────────────────────────────────────────────────
#
# REGION vs ZONE — what is the difference?
#
#   REGION  = a geographic area (e.g. us-central1)
#             Used for: Cloud Run, static IP reservation,
#             regional load balancers, Cloud DNS, VPC connectors
#
#   ZONE    = a single data centre inside a region (e.g. us-central1-a)
#             Used for: GKE node pools, zonal GKE clusters,
#             Compute Engine VMs, zonal persistent disks
#
# A zone always belongs to a region. Your ZONE and REGION must match
# (e.g. zone us-central1-a is inside region us-central1).

# The GCP region — used for Cloud Run and regional resources
REGION=us-central1

# The GCP zone — used for GKE cluster and node pools
ZONE=us-central1-a

# ── Network ───────────────────────────────────────────────────

# The name of your VPC network
VPC_NETWORK=devops-vpc

# The name of the subnet inside that VPC (must be in the same region)
VPC_SUBNET=devops-subnet

# ── Kubernetes ────────────────────────────────────────────────

# The GKE cluster name
CLUSTER_NAME=devops-cluster

# The Kubernetes namespace to deploy all services into
# "default" is fine for most setups; change if you use a dedicated namespace
K8S_NAMESPACE=default

# ── Artifact Registry ─────────────────────────────────────────
#
# Artifact Registry is the modern replacement for Google Container Registry (gcr.io).
# Images are stored at: REGION-docker.pkg.dev/PROJECT_ID/REPO_NAME/image:tag

# The name of the Artifact Registry repository (created in Phase 1)
ARTIFACT_REPO=prod-repo

# Full image registry path — built from the values above
# You do not need to change this line; it is derived automatically
IMAGE_REGISTRY=${REGION}-docker.pkg.dev/${PROJECT_ID}/${ARTIFACT_REPO}

# ── Internal Networking ───────────────────────────────────────

# The hostname Cloud Run uses to reach services inside GKE over the VPC.
# This resolves via a Cloud DNS private zone — it is NOT a public domain.
# You can use any hostname here as long as it matches your DNS zone.
INTERNAL_GATEWAY_HOST=internal.devops-gateway.private

# The name given to the reserved static internal IP address (created in Phase 1)
INTERNAL_IP_NAME=devops-internal-ip

# The name of the Cloud DNS private zone (created in Phase 3)
DNS_ZONE_NAME=devops-internal-zone
